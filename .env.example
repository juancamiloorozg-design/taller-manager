# Copia este archivo como .env y completa los valores. No lo subas a git.

# Base de datos
DB_PASSWORD=cambia-esta-clave
DB_ROOT_PASSWORD=cambia-esta-otra-clave

# Primer administrador (solo se usa si todavia no existen usuarios)
ADMIN_EMAIL=admin@mitaller.com
ADMIN_PASSWORD=cambia-esta-clave-123

# Ponlo en true cuando el sitio se sirva por HTTPS
SESSION_COOKIE_SECURE=false

# Datos del taller: salen en las paginas legales y en la orden impresa
TALLER_NOMBRE=Mi Taller S.A.S.
TALLER_NIT=900.000.000-0
TALLER_DIRECCION=Calle 1 # 2-34
TALLER_CIUDAD=Bogota
TALLER_EMAIL=datos@mitaller.com
TALLER_TELEFONO=3000000000

# Dias de validez que se imprimen en las cotizaciones
TALLER_COTIZACION_DIAS=8
